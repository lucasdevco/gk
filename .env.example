APP_ENV=development
APP_BANNER=true
APP_ADDR=:8080
APP_PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://gk:gk@localhost:5432/gk?sslmode=disable
LOG_LEVEL=debug
LOG_FORMAT=text
# Colorize text log levels; ignored when LOG_FORMAT=json.
LOG_COLOR=true
SHUTDOWN_TIMEOUT=10s

# Optional: start mise run docker:observability, then enable local export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
# OTEL_METRIC_EXPORT_INTERVAL=5000
# OTEL_SERVICE_NAME=gk
