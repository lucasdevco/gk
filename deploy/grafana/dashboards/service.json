{
  "uid": "gk-service",
  "title": "GK Service Overview",
  "description": "Service telemetry for deployed GK instances. Requires the provided Collector service-label mapping. Demo and health traffic are excluded from HTTP panels. Query minimum step 1m accommodates the default 60s OTLP export (rate window at least 4m).",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "gk",
    "service"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(gk_db_pool_connections_max, service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(gk_db_pool_connections_max{service_name=~\"$service\"}, deployment_environment)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(gk_db_pool_connections_max{service_name=~\"$service\",deployment_environment=~\"$environment\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "description": "Health probes and development demonstrations are excluded.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route, http_request_method) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "HTTP latency",
      "description": "Aggregate histogram buckets before calculating percentiles. Not an average of instance percentiles.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "interval": "1m"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx ratio",
      "description": "Zero with successful traffic and no errors; no data when there is no traffic.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\",http_response_status_code=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval])))) / (sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP 4xx ratio",
      "description": "Client errors are separate from server errors.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\",http_response_status_code=~\"4..\"}[$__rate_interval])) or (0 * sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval])))) / (sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval])) > 0)",
          "legendFormat": "4xx",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "HTTP responses by status",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "HTTP p95 by route",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,http_route,http_request_method) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\",http_route!~\"/health/.*|/api/v1/(demo|observability)/.*\"}[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Go runtime memory used",
      "description": "Memory accounted for by Go runtime; not container RSS.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (go_memory_used_bytes{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Go allocation rate",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(go_memory_allocated_bytes_total{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Goroutines",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (go_goroutine_count{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Go GC heap target",
      "description": "Go GC heap target; not GC pause duration.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (go_memory_gc_goal_bytes{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Database pool connections",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gk_db_pool_connections_total{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} total",
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "gk_db_pool_connections_acquired{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} acquired",
          "interval": "1m"
        },
        {
          "refId": "C",
          "expr": "gk_db_pool_connections_idle{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} idle",
          "interval": "1m"
        },
        {
          "refId": "D",
          "expr": "gk_db_pool_connections_max{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} max",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Database pool utilization",
      "description": "Acquired / configured maximum per instance. An idle pool is 0%; a missing exporter is no data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gk_db_pool_connections_acquired{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"} / gk_db_pool_connections_max{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Collector scrape health",
      "description": "Prometheus \u2192 Collector reachability only. Does not prove the application is alive.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"gk\"}",
          "legendFormat": "{{instance}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Last application metric age",
      "description": "Age of last exported pool sample; track alongside scrape health. Missing samples remain no data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (instance) (timestamp(gk_db_pool_connections_max{service_name=~\"$service\",deployment_environment=~\"$environment\",instance=~\"$instance\"}))",
          "legendFormat": "{{instance}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
